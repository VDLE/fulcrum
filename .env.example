# Copy this file to .env and fill in the values before running docker compose.
# Do NOT commit the resulting .env file.

# MySQL
MYSQL_HOST=db
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DB=fulcrum

# Flask
SECRET_KEY=replace-with-a-random-64-char-string
SECRET_PASSWORD_SALT=replace-with-a-random-integer
FLASK_DEBUG=false
FLASK_PORT=5004

# File storage (mapped to named Docker volumes inside the backend container)
RESULTS_BASE_DIR_PATH=/app/data/participants_results
TRACKING_TOOL_DIR_PATH=/app/data/tracking_tool_downloads

# SMTP credentials for outbound mail (account confirmation, password reset).
#
# Port 465 (implicit SSL) is the default because some Docker bridge setups
# block outbound 587 even when the host can reach it. 465 and 587 are
# functionally equivalent for our use. Pick one; the two TLS flags are
# mutually exclusive:
#   port 465:  MAIL_USE_SSL=true   MAIL_USE_TLS=false
#   port 587:  MAIL_USE_SSL=false  MAIL_USE_TLS=true
#
# Gmail example:
#   1. Enable 2-Step Verification on the Google account.
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Use the 16-char password WITHOUT the display spaces.
#      e.g. "abcd efgh ijkl mnop" becomes "abcdefghijklmnop"
#
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=465
#   MAIL_USE_TLS=false
#   MAIL_USE_SSL=true
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=abcdefghijklmnop
#   MAIL_DEFAULT_SENDER=you@gmail.com
#
# Other providers:
#   Outlook / Office 365:  smtp.office365.com  587  TLS
#   SendGrid:              smtp.sendgrid.net   587  TLS  (user "apikey", password <key>)
#                          fallback port 2525 if 587/465 are blocked
MAIL_SERVER=
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Socket timeout in seconds for SMTP connect. Keeps a blocked relay
# from hanging gunicorn workers.
MAIL_TIMEOUT=10

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Frontend origin (used for CORS and Flask-Security email-confirmation redirects).
# Set to the public URL in production, e.g. https://fulcrum.example.com
EXPECTED_FRONTEND_DOMAIN_URL=http://localhost
